---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";

const experiments = await getCollection("experiments");

const subjects = [
  {
    title: "Deep Learning Systems",
    slug: "deep-learning",
    description: "Multi-Layer Perceptrons, model optimization, parameter norm regularization, and convolutional/recurrent layers.",
    tags: ["MLP", "Generalization", "Keras", "TensorFlow"],
    count: experiments.filter((e) => e.data.subjectSlug === "deep-learning").length,
  },
  {
    title: "Cloud Computing",
    slug: "cloud-computing",
    description: "Virtualization instances, Security Group port firewalls, Docker containerization, and orchestration profiles.",
    tags: ["AWS", "EC2", "Docker", "Containers"],
    count: experiments.filter((e) => e.data.subjectSlug === "cloud-computing").length,
  }
];

const totalViva = experiments.reduce(
  (sum, exp) => sum + (exp.data.vivaQuestions?.length ?? 0),
  0
);

const formatNumber = (n: number) => String(n).padStart(2, "0");
---

<BaseLayout
  title="Academic Lab Manuals Hub"
  description="A central hub for university lab manuals and exam revision: deep learning systems, cloud computing, and more."
>
  <!-- Academic Document Header with Subtle Gradient and Grain -->
  <section class="relative border-b border-border bg-gradient-to-b from-card/30 via-card/10 to-background/5 overflow-hidden">
    <div class="dot-grid pointer-events-none absolute inset-0 opacity-20" aria-hidden="true"></div>
    <div class="relative mx-auto w-full max-w-5xl px-6 py-16 sm:py-24">
      <div class="reveal flex flex-col justify-between">
        <div class="max-w-3xl">
          <div class="mb-6 inline-flex flex-col gap-1.5 border-l-4 border-primary pl-4">
            <span class="font-mono text-[0.7rem] uppercase tracking-widest text-muted-foreground">
              Department of Computer Science & Engineering
            </span>
            <span class="font-mono text-[0.65rem] uppercase tracking-wider text-primary font-bold">
              Academic Hub & Course Records
            </span>
          </div>
          
          <h1 class="font-sans text-4xl font-extrabold tracking-tight text-foreground sm:text-6xl leading-tight">
            Laboratory Manuals<br />
            <span class="text-primary font-serif italic font-normal bg-gradient-to-r from-primary to-primary/80 bg-clip-text text-transparent">& Syllabus Index</span>
          </h1>
          
          <p class="mt-6 font-serif text-[1.1rem] leading-relaxed text-muted-foreground max-w-2xl">
            This portal serves as the official reference repository for computer science laboratory course works. 
            Students can browse structured experiment logs, explore implementation codes, verify outputs, and prepare for oral evaluations.
          </p>
        </div>

        <!-- Academic Metadata Badge Grid -->
        <div class="mt-12 pt-8 border-t border-border/80 max-w-xl">
          <div class="grid grid-cols-3 gap-4 font-mono text-xs">
            <div class="bg-card/75 border border-border/70 rounded-2xl p-4 shadow-sm hover:border-primary/30 transition-colors duration-200">
              <span class="text-muted-foreground block text-[0.65rem] uppercase tracking-wider font-bold">COURSES</span>
              <span class="mt-1.5 text-2xl font-extrabold text-foreground block">{formatNumber(subjects.length)}</span>
            </div>
            <div class="bg-card/75 border border-border/70 rounded-2xl p-4 shadow-sm hover:border-primary/30 transition-colors duration-200">
              <span class="text-muted-foreground block text-[0.65rem] uppercase tracking-wider font-bold">EXPERIMENTS</span>
              <span class="mt-1.5 text-2xl font-extrabold text-foreground block">{formatNumber(experiments.length)}</span>
            </div>
            <div class="bg-card/75 border border-border/70 rounded-2xl p-4 shadow-sm hover:border-primary/30 transition-colors duration-200">
              <span class="text-muted-foreground block text-[0.65rem] uppercase tracking-wider font-bold">VIVA ITEMS</span>
              <span class="mt-1.5 text-2xl font-extrabold text-foreground block">{formatNumber(totalViva)}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Manual Content -->
  <section class="mx-auto w-full max-w-5xl px-6 py-12 flex-1 grid gap-10 md:grid-cols-[1.3fr_0.7fr]">
    
    <!-- Left Column: Syllabus Directory -->
    <div class="flex flex-col justify-start">
      <div class="mb-6 flex items-baseline justify-between border-b border-border pb-3">
        <h2 class="font-sans text-xs font-bold uppercase tracking-wider text-foreground">
          Syllabus Directory
        </h2>
        <span class="font-mono text-[0.7rem] text-muted-foreground">
          SEC-01 / ACTIVE_COURSES
        </span>
      </div>

      <div class="flex flex-col gap-6">
        {
          subjects.map((sub, i) => (
            <a
              href={`/${sub.slug}`}
              class:list={[
                "group reveal flex flex-col p-6 bg-card border border-border hover:border-primary/40 rounded-2xl shadow-xs hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 justify-between relative overflow-hidden",
                i === 0 ? "animation-delay-100" : "animation-delay-200",
              ]}
            >
              <!-- Hover border glow effect -->
              <div class="absolute left-0 top-0 bottom-0 w-1 bg-primary transform scale-y-0 group-hover:scale-y-100 transition-transform duration-300 origin-top"></div>
              
              <div>
                <div class="flex items-center justify-between border-b border-border/40 pb-3 mb-4">
                  <span class="font-mono text-[0.65rem] text-muted-foreground uppercase tracking-wider">
                    Syllabus Record
                  </span>
                  <span class="font-mono text-[0.65rem] text-primary bg-primary/5 border border-primary/20 px-2.5 py-0.5 rounded-xl font-bold">
                    {sub.count} Experiments
                  </span>
                </div>

                <h3 class="font-sans text-xl font-bold tracking-tight text-foreground group-hover:text-primary transition-colors duration-150">
                  {sub.title}
                </h3>
                
                <p class="mt-3 text-sm text-muted-foreground leading-relaxed font-serif">
                  {sub.description}
                </p>
              </div>

              <div class="mt-8 pt-4 border-t border-border/40 flex items-center justify-between">
                <div class="flex flex-wrap gap-1.5">
                  {sub.tags.slice(0, 3).map((tag) => (
                    <span class="border border-border/80 rounded-lg bg-background/60 px-2 py-0.5 font-mono text-[0.6rem] text-muted-foreground">
                      #{tag}
                    </span>
                  ))}
                </div>
                <span class="font-mono text-[0.65rem] text-primary group-hover:translate-x-1 transition-transform duration-200 font-bold uppercase tracking-widest flex items-center gap-1">
                  view_manual.exe <span class="text-sm">&rarr;</span>
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>

    <!-- Right Column: Student Guidelines / General Instructions -->
    <div class="flex flex-col justify-start">
      <div class="mb-6 flex items-baseline justify-between border-b border-border pb-3">
        <h2 class="font-sans text-xs font-bold uppercase tracking-wider text-foreground">
          Course Regulations
        </h2>
        <span class="font-mono text-[0.7rem] text-muted-foreground">
          SEC-02 / RULES
        </span>
      </div>

      <div class="reveal bg-card/70 border border-border rounded-2xl p-6 font-serif text-sm text-muted-foreground shadow-xs hover:border-primary/20 transition-all duration-300 relative overflow-hidden">
        <!-- Accent line -->
        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-primary/30 via-primary to-primary/30"></div>
        
        <h3 class="font-sans text-xs font-bold uppercase tracking-wider text-foreground mb-5 mt-2">
          Laboratory Regulations
        </h3>
        
        <ol class="space-y-5 list-decimal pl-4 leading-relaxed">
          <li>
            <strong class="font-sans text-[0.75rem] text-foreground uppercase tracking-wider block mb-1">Syllabus Coverage</strong>
            All practical sessions correspond directly to the prescribed course curriculum. Check individual subject sections for detailed logs.
          </li>
          <li>
            <strong class="font-sans text-[0.75rem] text-foreground uppercase tracking-wider block mb-1">Evaluation Criteria</strong>
            Continuous assessment is based on the logic implementation, parameter log files, training accuracies, and overall correctness.
          </li>
          <li>
            <strong class="font-sans text-[0.75rem] text-foreground uppercase tracking-wider block mb-1">Viva-Voce Prep</strong>
            Oral exams assess conceptual understanding of key algorithms, parameters, architectures, and design trade-offs. Each experiment lists common viva questions for self-study.
          </li>
          <li>
            <strong class="font-sans text-[0.75rem] text-foreground uppercase tracking-wider block mb-1">Colab/Code Execution</strong>
            Direct Jupyter/Google Colab notebooks are linked under each experiment to facilitate fast verification and interactive model training.
          </li>
        </ol>

        <div class="mt-8 pt-6 border-t border-border/80 font-mono text-[0.65rem] text-muted-foreground flex flex-col gap-1.5">
          <div class="flex items-center justify-between">
            <span>REVISION STATE:</span>
            <span class="font-bold text-emerald-600 dark:text-emerald-400">READY</span>
          </div>
          <div class="flex items-center justify-between">
            <span>SESSION:</span>
            <span class="font-bold">AUTUMN TERM</span>
          </div>
        </div>
      </div>
    </div>

  </section>
</BaseLayout>

<script>
  // Reveal-on-scroll logic
  const revealObserver = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          revealObserver.unobserve(entry.target);
        }
      }
    },
    { threshold: 0.1, rootMargin: "0px 0px -40px 0px" }
  );

  document.querySelectorAll(".reveal").forEach((el) => revealObserver.observe(el));
</script>
