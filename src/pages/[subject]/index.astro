---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const experiments = await getCollection("experiments");
  const subjects = [...new Set(experiments.map((exp) => exp.data.subjectSlug))];
  return subjects.map((subject) => ({
    params: { subject },
  }));
}

const { subject } = Astro.params;
const experiments = (await getCollection("experiments"))
  .filter((exp) => exp.data.subjectSlug === subject)
  .sort((a, b) => a.data.experimentNumber - b.data.experimentNumber);

const subjectTitle = experiments[0]?.data.subject || "Lab Manual";
const totalViva = experiments.reduce(
  (sum, exp) => sum + (exp.data.vivaQuestions?.length ?? 0),
  0
);
const datasets = [...new Set(experiments.map((exp) => exp.data.dataset).filter(Boolean))];

const formatNumber = (n: number) => String(n).padStart(2, "0");

// Sparkline path generator
function mulberry32(seed: number) {
  let a = seed >>> 0;
  return function () {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

function makeCurve(seed: number, points = 24, noise = 0.05) {
  const rand = mulberry32(seed);
  const out: number[] = [];
  for (let i = 0; i < points; i++) {
    const t = i / (points - 1);
    const decay = Math.exp(-3 * t);
    const wobble = Math.sin(t * 8 + seed) * 0.03;
    const jitter = (rand() - 0.5) * noise * (1 - t * 0.5);
    out.push(Math.max(0.05, Math.min(1, decay + wobble + jitter)));
  }
  return out;
}

function toPath(values: number[], w: number, h: number, pad = 4) {
  const step = (w - pad * 2) / (values.length - 1);
  return values
    .map((v, i) => {
      const x = pad + i * step;
      const y = pad + (1 - v) * (h - pad * 2);
      return `${i === 0 ? "M" : "L"}${x.toFixed(1)} ${y.toFixed(1)}`;
    })
    .join(" ");
}

const sparks = experiments.map((exp) => ({
  ...exp,
  sparkPath: toPath(makeCurve(200 + exp.data.experimentNumber * 9, 24, 0.08), 260, 40, 4),
}));
---

<BaseLayout
  title={`${subjectTitle} Manual`}
  description={`Lab manual records, implementations, and questions for ${subjectTitle}.`}
>
  <!-- Header / Breadcrumbs -->
  <section class="relative overflow-hidden border-b border-border bg-card/10">
    <div class="dot-grid pointer-events-none absolute inset-0 opacity-20" aria-hidden="true"></div>
    <div class="relative mx-auto w-full max-w-5xl px-4 py-12 sm:px-6">
      <div class="reveal flex flex-col justify-between">
        <div>
          <nav class="mb-4">
            <a
              href="/"
              class="inline-flex items-center gap-1.5 font-mono text-xs text-muted-foreground transition-colors hover:text-primary"
            >
              <span>←</span>
              <span>back to dashboard</span>
            </a>
          </nav>
          
          <div class="mb-3 inline-flex items-center gap-2 border border-border bg-card/60 rounded-xl px-2.5 py-0.5 font-mono text-[0.65rem] text-muted-foreground uppercase tracking-wider">
            <span>Syllabus Log</span>
            <span class="text-border">|</span>
            <span>{subjectTitle}</span>
          </div>
          
          <h1 class="font-heading text-3xl font-bold tracking-tight sm:text-4xl text-foreground">
            {subjectTitle}<br />
            <span class="text-primary">Laboratory Manual</span>
          </h1>
          <p class="mt-4 max-w-xl text-sm leading-relaxed text-muted-foreground font-serif">
            A comprehensive reference manual containing {experiments.length} structured hands-on experiments for {subjectTitle}. Each log details theoretical background, implementation code, standard observation parameters, and viva questions.
          </p>
        </div>

        <div class="mt-8 border-t border-border pt-6 max-w-md">
          <div class="grid grid-cols-3 gap-3 font-mono text-xs">
            <div class="border border-border bg-card rounded-2xl p-3 shadow-2xs">
              <span class="text-muted-foreground block text-[0.6rem] uppercase font-bold">LOGS</span>
              <span class="mt-0.5 text-xl font-bold text-foreground block">{formatNumber(experiments.length)}</span>
            </div>
            <div class="border border-border bg-card rounded-2xl p-3 shadow-2xs">
              <span class="text-muted-foreground block text-[0.6rem] uppercase font-bold">RESOURCES</span>
              <span class="mt-0.5 text-xl font-bold text-foreground block">{formatNumber(datasets.length || 1)}</span>
            </div>
            <div class="border border-border bg-card rounded-2xl p-3 shadow-2xs">
              <span class="text-muted-foreground block text-[0.6rem] uppercase font-bold">VIVA_QA</span>
              <span class="mt-0.5 text-xl font-bold text-foreground block">{formatNumber(totalViva)}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Table of Contents / Experiments Catalog -->
  <section class="mx-auto w-full max-w-5xl flex-1 px-4 py-12 sm:px-6">
    <div class="mb-6 flex items-baseline justify-between border-b border-border pb-3">
      <h2 class="font-heading text-sm font-bold uppercase tracking-wider text-foreground">
        Table of Contents
      </h2>
      <span class="font-mono text-xs text-muted-foreground">
        SEC-01 / INDEX
      </span>
    </div>

    <div class="grid gap-6 sm:grid-cols-2">
      {
        sparks.map((exp, i) => (
          <a
            href={`/experiments/${exp.data.subjectSlug}/${exp.id.split("/")[1] || exp.id}`}
            class:list={[
              "group reveal flex flex-col p-6 bg-card border border-border rounded-2xl shadow-sm hover:shadow-md hover:border-primary/50 transition-all duration-200 justify-between",
              i === 0
                ? "animation-delay-100"
                : i === 1
                  ? "animation-delay-200"
                  : "animation-delay-300",
            ]}
          >
            <div>
              <!-- Experiment Header -->
              <div class="flex items-center justify-between border-b border-border/60 pb-3 mb-4">
                <span class="border border-primary/35 rounded-xl px-2 py-0.5 text-[0.68rem] bg-primary/5 font-mono font-semibold text-primary">
                  EXP-{formatNumber(exp.data.experimentNumber)}
                </span>
                <span class="font-mono text-[0.65rem] text-muted-foreground">
                  resource: {exp.data.dataset || "Cloud"}
                </span>
              </div>

              <!-- Title & Summary -->
              <h3 class="font-heading text-base font-bold tracking-tight text-foreground group-hover:text-primary transition-colors duration-150">
                {exp.data.title}
              </h3>
              <p class="mt-2 text-xs text-muted-foreground leading-relaxed font-serif">
                {exp.data.description}
              </p>
            </div>

            <div class="mt-5 pt-4 border-t border-border/40 flex items-center justify-between">
              <!-- Tags -->
              <div class="flex flex-wrap gap-1">
                {exp.data.tags.slice(0, 2).map((tag) => (
                  <span class="border border-border/80 rounded-lg bg-background/50 px-1.5 py-0.5 font-mono text-[0.6rem] text-muted-foreground">
                    #{tag}
                  </span>
                ))}
              </div>

              <!-- Miniature Sparkline -->
              <div class="w-[80px] border border-border/60 rounded-lg bg-background/30 p-1">
                <svg
                  viewBox="0 0 260 40"
                  class="h-5 w-full opacity-80 group-hover:opacity-100 transition-opacity duration-150"
                  role="img"
                  aria-label="Loss curve"
                >
                  <path
                    d={exp.sparkPath}
                    fill="none"
                    stroke="var(--primary)"
                    stroke-width="1.8"
                    stroke-linecap="round"
                  />
                </svg>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>

<script>
  const revealObserver = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          revealObserver.unobserve(entry.target);
        }
      }
    },
    { threshold: 0.1, rootMargin: "0px 0px -40px 0px" }
  );

  document.querySelectorAll(".reveal").forEach((el) => revealObserver.observe(el));
</script>
