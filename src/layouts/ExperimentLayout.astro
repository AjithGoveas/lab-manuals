---
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"experiments">;
  headings?: { depth: number; slug: string; text: string }[];
  prev?: CollectionEntry<"experiments"> | null;
  next?: CollectionEntry<"experiments"> | null;
}

const { entry, headings = [], prev, next } = Astro.props;
const { data } = entry;

const isSetup = entry.id.includes("setup") || entry.id.includes("guide");

const prevParts = prev ? prev.id.split("/") : [];
const prevSubject = prevParts[0] || prev?.data.subjectSlug;
const prevSlug = (prevParts[1] || "").replace(/\.md$/, "");

const nextParts = next ? next.id.split("/") : [];
const nextSubject = nextParts[0] || next?.data.subjectSlug;
const nextSlug = (nextParts[1] || "").replace(/\.md$/, "");

const formatNumber = (n: number) => String(n).padStart(2, "0");
const questions = data.vivaQuestions?.length ?? 0;
const toc = headings.filter((h) => h.depth === 2);
---

<BaseLayout
  title={data.title}
  description={data.description}
  subjectSlug={data.subjectSlug}
  experimentSlug={entry.id.split("/")[1] || entry.id}
>
  <div id="reading-progress" class="fixed top-(--header-h) right-0 left-0 z-40 h-[2.5px] pointer-events-none" aria-hidden="true"></div>

  <article class="mx-auto w-full max-w-5xl px-6 py-10">
    <!-- Breadcrumb back link -->
    <nav class="mb-8">
      <a
        href={`/${data.subjectSlug}`}
        class="inline-flex items-center gap-2 font-mono text-xs text-muted-foreground transition-colors hover:text-primary font-bold uppercase tracking-wider"
      >
        <span>&larr;</span>
        <span>back to {data.subject.toLowerCase()} manual</span>
      </a>
    </nav>

    <!-- Academic Record Page Header -->
    <header class="relative border border-border bg-card rounded-2xl p-6 sm:p-8 mb-10 shadow-xs overflow-hidden">
      <!-- Top primary bar decoration -->
      <div class="absolute top-0 left-0 right-0 h-1 bg-linear-to-r from-primary/30 via-primary to-primary/30"></div>

      <!-- Metadata Row -->
      {!isSetup && (
        <div class="grid grid-cols-2 gap-4 border-b border-border/60 pb-5 font-mono text-xs sm:grid-cols-4">
          <div>
            <span class="text-muted-foreground block text-[0.6rem] uppercase tracking-wider font-bold">EXPERIMENT</span>
            <span class="font-bold text-primary mt-1 block text-sm">EXP-{formatNumber(data.experimentNumber)}</span>
          </div>
          <div>
            <span class="text-muted-foreground block text-[0.6rem] uppercase tracking-wider font-bold">DATASET</span>
            <span class="text-foreground mt-1 block font-bold text-sm">{data.dataset || "N/A"}</span>
          </div>
          <div>
            <span class="text-muted-foreground block text-[0.6rem] uppercase tracking-wider font-bold">VIVA ITEMS</span>
            <span class="text-foreground mt-1 block font-bold text-sm">{formatNumber(questions)} questions</span>
          </div>
          <div>
            <span class="text-muted-foreground block text-[0.6rem] uppercase tracking-wider font-bold">LAB NOTEBOOK</span>
            {data.notebookUrl ? (
              <a
                href={data.notebookUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-primary hover:underline font-bold mt-1 block text-sm items-center gap-0.5"
              >
                open_notebook <span class="text-[0.65rem]">&nearr;</span>
              </a>
            ) : (
              <span class="text-muted-foreground mt-1 block text-sm">none</span>
            )}
          </div>
        </div>
      )}

      <!-- Title & description -->
      <h1 class="font-sans mt-6 text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl leading-tight">
        {data.title}
      </h1>
      <p class="mt-4 text-base leading-relaxed text-muted-foreground font-serif max-w-3xl">
        {data.description}
      </p>

      <div class="mt-6 flex flex-wrap gap-1.5">
        {data.tags.map((tag) => (
          <span class="border border-border/80 rounded-lg bg-background/60 px-2 py-0.5 font-mono text-[0.6rem] text-muted-foreground">
            #{tag}
          </span>
        ))}
      </div>
    </header>

    <!-- Two-column content layout -->
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_220px]">

      <!-- Left Column: Primary Markdown slot -->
      <div class="min-w-0 prose prose-neutral dark:prose-invert max-w-none font-serif prose-headings:font-sans prose-headings:tracking-tight prose-headings:font-bold prose-h2:text-xl prose-h2:mt-12 prose-h2:border-b prose-h2:border-border prose-h2:pb-2.5 prose-h3:text-base prose-p:text-sm prose-p:leading-relaxed prose-li:text-sm text-foreground">
        <slot />
      </div>

      <!-- Right Column: Sticky Table of Contents -->
      {
        toc.length > 1 && (
          <aside class="hidden lg:block">
            <div class="sticky top-24 border border-border bg-card/60 rounded-2xl p-5 shadow-2xs">
              <p class="font-mono text-[0.65rem] uppercase tracking-widest text-muted-foreground border-b border-border pb-2 mb-3 font-bold">
                SECTIONS
              </p>
              <nav class="flex flex-col gap-2">
                {toc.map((h) => (
                  <a
                    href={`#${h.slug}`}
                    data-toc-link
                    class="font-mono text-[0.7rem] text-muted-foreground transition-colors hover:text-primary truncate block py-0.5 hover:translate-x-0.5 transform duration-150"
                  >
                    // {h.text.toUpperCase()}
                  </a>
                ))}
              </nav>
            </div>
          </aside>
        )
      }
    </div>

    <!-- Navigation / Step Controls at Bottom -->
    {!isSetup && (
      <div class="mt-16 border-t border-border/80 pt-8">
        <div class="mb-6 flex items-baseline justify-between font-mono text-[0.65rem] text-muted-foreground tracking-wider uppercase font-bold">
          <span>[Manual Navigation]</span>
          <span>Syllabus Sequence</span>
        </div>

        <div class="grid gap-5 sm:grid-cols-2">
          {prev && (
            <a
              href={`/experiments/${prevSubject}/${prevSlug}`}
              class="group border border-border bg-card hover:border-primary/40 rounded-2xl p-5 shadow-2xs hover:shadow-xs transition-all duration-200"
            >
              <span class="font-mono text-[0.62rem] text-muted-foreground block uppercase font-semibold">
                &larr; PREVIOUS EXPERIMENT / EXP-{formatNumber(prev.data.experimentNumber)}
              </span>
              <span class="font-sans mt-2 text-sm font-bold text-foreground group-hover:text-primary block transition-colors leading-tight">
                {prev.data.title}
              </span>
            </a>
          )}
          {next && (
            <a
              href={`/experiments/${nextSubject}/${nextSlug}`}
              class="group border border-border bg-card hover:border-primary/40 rounded-2xl p-5 text-right shadow-2xs hover:shadow-xs transition-all duration-200 sm:col-start-2"
            >
              <span class="font-mono text-[0.62rem] text-muted-foreground block uppercase font-semibold">
                NEXT EXPERIMENT / EXP-{formatNumber(next.data.experimentNumber)} &rarr;
              </span>
              <span class="font-sans mt-2 text-sm font-bold text-foreground group-hover:text-primary block transition-colors leading-tight">
                {next.data.title}
              </span>
            </a>
          )}
        </div>
      </div>
    )}
  </article>
</BaseLayout>

<script>
  // Process Mermaid code blocks
  document.querySelectorAll('pre[data-language="mermaid"], pre code.language-mermaid, .language-mermaid').forEach((el) => {
    const pre = el.tagName.toLowerCase() === 'pre' ? el : el.closest('pre') || el;
    const lineSpans = pre.querySelectorAll(".line");
    let code = "";
    if (lineSpans.length > 0) {
      code = Array.from(lineSpans).map((l) => l.textContent).join("\n");
    } else {
      code = pre.querySelector("code")?.innerText || pre.innerText || "";
    }
    const div = document.createElement("div");
    div.className = "mermaid my-6 flex justify-center bg-card p-4 rounded-2xl border border-border/60 overflow-x-auto";
    div.textContent = code.trim();
    pre.replaceWith(div);
  });
  if (window.mermaid) {
    try {
      window.mermaid.initialize({
        startOnLoad: false,
        theme: document.documentElement.classList.contains("dark") ? "dark" : "default",
      });
      window.mermaid.run();
    } catch (err) {
      console.error("Mermaid initialization failed:", err);
    }
  }

  // Process Graphviz DOT code blocks
  const dotBlocks = document.querySelectorAll('pre[data-language="dot"], pre[data-language="graphviz"], pre code.language-dot, pre code.language-graphviz');
  if (dotBlocks.length > 0 && window["@hpcc-js/wasm"]) {
    window["@hpcc-js/wasm"].Graphviz.load().then((graphviz) => {
      dotBlocks.forEach((el) => {
        const pre = el.tagName.toLowerCase() === 'pre' ? el : el.closest('pre') || el;
        const code = pre.querySelector("code")?.innerText || pre.innerText;
        try {
          const svg = graphviz.layout(code, "svg", "dot");
          const div = document.createElement("div");
          div.className = "graphviz-graph my-6 flex justify-center bg-card p-4 rounded-2xl border border-border/60 overflow-x-auto";
          div.innerHTML = svg;
          pre.replaceWith(div);
        } catch (err) {
          console.error("Graphviz rendering failed:", err);
        }
      });
    });
  }

  // Process blockquotes to render GitHub-style alerts dynamically
  const ALERT_CONFIGS: Record<string, { type: string; title: string; icon: string }> = {
    NOTE: {
      type: "note",
      title: "Note",
      icon: '<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="currentColor"><path d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8Zm8-6.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13ZM6.5 7.75A.75.75 0 0 1 7.25 7h1a.75.75 0 0 1 .75.75v2.75h.25a.75.75 0 0 1 0 1.5h-2a.75.75 0 0 1 0-1.5h.25v-2h-.25a.75.75 0 0 1-.75-.75ZM8 6a1 1 0 1 1 0-2 1 1 0 0 1 0 2Z"></path></svg>',
    },
    TIP: {
      type: "tip",
      title: "Tip",
      icon: '<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="currentColor"><path d="M8 1.5c-2.363 0-4 1.69-4 3.75 0 .984.424 1.625.984 2.304l.214.253c.223.264.47.556.673.868.409.627.629 1.343.629 2.075v.25h3v-.25c0-.732.22-1.448.629-2.075.203-.312.45-.604.673-.868l.214-.253c.56-.679.984-1.32.984-2.304 0-2.06-1.637-3.75-4-3.75ZM6 12v.75A1.25 1.25 0 0 0 7.25 14h1.5A1.25 1.25 0 0 0 10 12.75V12H6Z"></path></svg>',
    },
    IMPORTANT: {
      type: "important",
      title: "Important",
      icon: '<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="currentColor"><path d="M0 1.75C0 .784.784 0 1.75 0h12.5C15.216 0 16 .784 16 1.75v9.5A1.75 1.75 0 0 1 14.25 13H9.06l-2.573 2.573A1.458 1.458 0 0 1 4 14.543V13H1.75A1.75 1.75 0 0 1 0 11.25Zm1.75-.25a.25.25 0 0 0-.25.25v9.5c0 .138.112.25.25.25h3.25a.75.75 0 0 1 .75.75v2.19l2.72-2.72a.749.749 0 0 1 .53-.22h5.25a.25.25 0 0 0 .25-.25v-9.5a.25.25 0 0 0-.25-.25Zm6.25 2.5a.75.75 0 0 1 .75.75v3.5a.75.75 0 0 1-1.5 0v-3.5A.75.75 0 0 1 8 4Zm0 6a1 1 0 1 1 0-2 1 1 0 0 1 0 2Z"></path></svg>',
    },
    WARNING: {
      type: "warning",
      title: "Warning",
      icon: '<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="currentColor"><path d="M6.457 1.047c.659-1.234 2.427-1.234 3.086 0l6.082 11.378A1.75 1.75 0 0 1 14.082 15H1.918a1.75 1.75 0 0 1-1.543-2.575Zm1.763.707a.25.25 0 0 0-.44 0L1.698 13.132a.25.25 0 0 0 .22.368h12.164a.25.25 0 0 0 .22-.368Zm.53 3.996v2.5a.75.75 0 0 1-1.5 0v-2.5a.75.75 0 0 1 1.5 0ZM9 11a1 1 0 1 1-2 0 1 1 0 0 1 2 0Z"></path></svg>',
    },
    CAUTION: {
      type: "caution",
      title: "Caution",
      icon: '<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="currentColor"><path d="M4.47.04c.328-.04.656-.04.984 0l5.59 1.49c.31.08.59.24.81.46l3.65 3.65c.22.22.38.5.46.81l1.49 5.59c.04.328.04.656 0 .984l-1.49 5.59c-.08.31-.24.59-.46.81l-3.65 3.65c-.22.22-.5.38-.81.46l-5.59 1.49c-.328.04-.656.04-.984 0l-5.59-1.49c-.31-.08-.59-.24-.81-.46l-3.65-3.65c-.22-.22-.38-.5-.46-.81l-1.49-5.59c-.04-.328-.04-.656 0-.984l1.49-5.59c.08-.31.24-.59.46-.81l3.65-3.65c.22-.22.5-.38.81-.46Zm.78 1.49-3.4 3.4L.49 10.3l1.36 5.37 5.37 1.36 3.4-3.4 1.36-5.37L10.62 4.89l-5.37-1.36ZM8 4a.75.75 0 0 1 .75.75v3.5a.75.75 0 0 1-1.5 0v-3.5A.75.75 0 0 1 8 4Zm0 6a1 1 0 1 1 0-2 1 1 0 0 1 0 2Z"></path></svg>',
    },
  };

  document.querySelectorAll(".prose blockquote").forEach((bq) => {
    const rawHtml = bq.innerHTML;
    for (const [key, cfg] of Object.entries(ALERT_CONFIGS)) {
      if (rawHtml.includes(`[!${key}]`)) {
        let contentHtml = rawHtml.replace(new RegExp(`\\[!${key}\\]\\s*(?:<br\\s*\\/?>)?`, "i"), "").trim();
        contentHtml = contentHtml.replace(/^<p>\s*<\/p>/i, "").trim();

        const alertDiv = document.createElement("div");
        alertDiv.className = `markdown-alert markdown-alert-${cfg.type}`;
        alertDiv.innerHTML = `
          <div class="markdown-alert-title">
            ${cfg.icon}
            <span>${cfg.title}</span>
          </div>
          <div class="markdown-alert-content">
            ${contentHtml}
          </div>
        `;
        bq.replaceWith(alertDiv);
        break;
      }
    }
  });

  if (window.renderMath) window.renderMath();

  const progress = document.getElementById("reading-progress");

  const track = document.createElement("div");
  track.className = "reading-progress-track";

  const fill = document.createElement("div");
  fill.className = "reading-progress-fill";
  fill.style.transform = "scaleX(0)";

  if (progress) {
    progress.appendChild(track);
    progress.appendChild(fill);
  }

  let ticking = false;
  const update = () => {
    const doc = document.documentElement;
    const max = doc.scrollHeight - window.innerHeight;
    const ratio = max > 0 ? Math.min(1, window.scrollY / max) : 0;
    if (fill) fill.style.transform = `scaleX(${ratio})`;
    ticking = false;
  };

  const onScroll = () => {
    if (!ticking) {
      requestAnimationFrame(update);
      ticking = true;
    }
  };
  document.addEventListener("scroll", onScroll, { passive: true });
  window.addEventListener("resize", onScroll, { passive: true });
  update();

  const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"));
  if (tocLinks.length > 0) {
    const headings = tocLinks
      .map((link) => document.getElementById(link.getAttribute("href")!.slice(1)))
      .filter(Boolean) as HTMLElement[];

    const onScrollSpy = () => {
      const offset = 140;
      let currentId = "";
      for (const heading of headings) {
        if (heading.getBoundingClientRect().top <= offset) {
          currentId = heading.id;
        } else {
          break;
        }
      }
      for (const link of tocLinks) {
        const isActive = link.getAttribute("href") === `#${currentId}`;
        link.classList.toggle("text-primary", isActive);
        link.classList.toggle("font-semibold", isActive);
        link.classList.toggle("text-muted-foreground", !isActive);
        if (isActive) link.setAttribute("aria-current", "true");
        else link.removeAttribute("aria-current");
      }
    };
    document.addEventListener("scroll", onScrollSpy, { passive: true });
    onScrollSpy();
  }

  // Enhanced copy button handler for code blocks (vanilla JS for zero hydration issues)
  const COPY_ICON = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>`;
  const CHECK_ICON = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>`;

  document.querySelectorAll("pre").forEach((pre) => {
    if (pre.dataset.copyEnhanced === "true") return;
    pre.dataset.copyEnhanced = "true";

    const lang = pre.getAttribute("data-language") ?? "code";

    const wrapper = document.createElement("div");
    wrapper.className = "group my-6 border border-border bg-[#0f1115] rounded-2xl overflow-hidden shadow-xs";

    const header = document.createElement("div");
    header.className = "flex items-center justify-between gap-3 border-b border-border/60 bg-black/20 px-3.5 py-2";

    const langLabel = document.createElement("span");
    langLabel.className = "font-mono text-[0.62rem] uppercase tracking-wider text-muted-foreground font-semibold";
    langLabel.textContent = lang;

    const button = document.createElement("button");
    button.type = "button";
    button.className = "inline-flex items-center gap-1.5 border border-border/30 rounded-xl px-2 py-0.5 font-mono text-[0.62rem] text-muted-foreground transition-all hover:border-primary hover:text-primary bg-black/10 focus-visible:outline-none data-copied:text-emerald-400 data-copied:border-emerald-400/40 cursor-pointer";
    button.innerHTML = `<span class="inline-flex items-center gap-1.5">${COPY_ICON} copy</span>`;

    let resetTimer: any;

    button.addEventListener("click", async () => {
      const code = pre.querySelector("code");
      const text = code?.innerText ?? pre.innerText ?? "";
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        return;
      }
      button.setAttribute("data-copied", "true");
      button.innerHTML = `<span class="inline-flex items-center gap-1.5">${CHECK_ICON} copied</span>`;
      if (resetTimer) clearTimeout(resetTimer);
      resetTimer = setTimeout(() => {
        button.removeAttribute("data-copied");
        button.innerHTML = `<span class="inline-flex items-center gap-1.5">${COPY_ICON} copy</span>`;
      }, 2000);
    });

    header.append(langLabel, button);
    wrapper.append(header);

    pre.parentElement?.insertBefore(wrapper, pre);
    pre.classList.add("m-0", "rounded-none", "!px-5", "!py-4", "!bg-transparent", "overflow-x-auto");
    wrapper.append(pre);
  });
</script>
