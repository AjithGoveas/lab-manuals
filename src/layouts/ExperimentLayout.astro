---
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"experiments">;
  headings?: { depth: number; slug: string; text: string }[];
  prev?: CollectionEntry<"experiments"> | null;
  next?: CollectionEntry<"experiments"> | null;
}

const { entry, headings = [], prev, next } = Astro.props;
const { data } = entry;

const formatNumber = (n: number) => String(n).padStart(2, "0");
const questions = data.vivaQuestions?.length ?? 0;
const toc = headings.filter((h) => h.depth === 2);
---

<BaseLayout title={data.title} description={data.description}>
  <div id="reading-progress" class="fixed top-(--header-h) right-0 left-0 z-40 h-[2.5px] pointer-events-none" aria-hidden="true"></div>

  <article class="mx-auto w-full max-w-5xl px-4 py-8 sm:px-6">
    <nav class="mb-6">
      <a
        href={`/${data.subjectSlug}`}
        class="inline-flex items-center gap-1.5 font-mono text-xs text-muted-foreground transition-colors hover:text-primary"
      >
        <span>←</span>
        <span>back to {data.subjectSlug} index</span>
      </a>
    </nav>

    <header class="border border-border bg-card rounded-2xl p-6 mb-8 shadow-sm">
      <div class="grid grid-cols-2 gap-4 border-b border-border/80 pb-4 font-mono text-xs sm:grid-cols-4">
        <div>
          <span class="text-muted-foreground block text-[0.6rem] uppercase font-bold">LOG NUM</span>
          <span class="font-bold text-primary mt-0.5 block">EXP-{formatNumber(data.experimentNumber)}</span>
        </div>
        <div>
          <span class="text-muted-foreground block text-[0.6rem] uppercase font-bold">DATASET</span>
          <span class="text-foreground mt-0.5 block font-semibold">{data.dataset || "N/A"}</span>
        </div>
        <div>
          <span class="text-muted-foreground block text-[0.6rem] uppercase font-bold">VIVA ITEMS</span>
          <span class="text-foreground mt-0.5 block font-semibold">{formatNumber(questions)} questions</span>
        </div>
        <div>
          <span class="text-muted-foreground block text-[0.6rem] uppercase font-bold">NOTEBOOK</span>
          {data.notebookUrl ? (
            <a
              href={data.notebookUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-primary hover:underline font-semibold mt-0.5 block"
            >
              open_notebook ↗
            </a>
          ) : (
            <span class="text-muted-foreground mt-0.5 block">none</span>
          )}
        </div>
      </div>

      <h1 class="font-heading mt-4 text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
        {data.title}
      </h1>
      <p class="mt-3 text-sm leading-relaxed text-muted-foreground font-serif">
        {data.description}
      </p>

      <div class="mt-4 flex flex-wrap gap-1">
        {data.tags.map((tag) => (
          <span class="border border-border/80 rounded-xl bg-background/50 px-2.5 py-0.5 font-mono text-[0.65rem] text-muted-foreground">
            #{tag}
          </span>
        ))}
      </div>
    </header>

    <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_200px]">
      <div class="min-w-0 prose prose-neutral dark:prose-invert max-w-none font-serif prose-headings:font-sans prose-headings:tracking-tight prose-headings:font-bold prose-h2:text-lg prose-h2:mt-10 prose-h2:border-b prose-h2:border-border prose-h2:pb-2 prose-h3:text-sm prose-p:text-sm prose-p:leading-relaxed prose-li:text-sm text-foreground">
        <slot />
      </div>

      {
        toc.length > 1 && (
          <aside class="hidden lg:block">
            <div class="sticky top-20 border border-border bg-card rounded-2xl p-5 shadow-2xs">
              <p class="font-mono text-[0.65rem] uppercase tracking-wider text-muted-foreground border-b border-border pb-1.5 mb-2.5 font-bold">
                sections
              </p>
              <nav class="flex flex-col gap-1.5">
                {toc.map((h) => (
                  <a
                    href={`#${h.slug}`}
                    data-toc-link
                    class="font-mono text-xs text-muted-foreground transition-all hover:text-primary truncate block py-0.5"
                  >
                    // {h.text}
                  </a>
                ))}
              </nav>
            </div>
          </aside>
        )
      }
    </div>

    <!-- Next / Prev steps -->
    <div class="mt-12 border-t border-border pt-8">
      <div class="mb-4 flex items-baseline justify-between font-mono text-[0.65rem] text-muted-foreground">
        <span>[ROUTE CONTROLS]</span>
        <span>CONTINUE TRANSCRIPT</span>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {prev && (
          <a
            href={`/experiments/${prev.id}`}
            class="group border border-border bg-card rounded-2xl p-5 shadow-2xs transition-all hover:border-primary/50 hover:shadow-sm hover:bg-primary/2"
          >
            <span class="font-mono text-[0.62rem] text-muted-foreground block">
              ← PREV LOG / EXP-{formatNumber(prev.data.experimentNumber)}
            </span>
            <span class="font-heading mt-1 text-sm font-bold text-foreground group-hover:text-primary block transition-colors">
              {prev.data.title}
            </span>
          </a>
        )}
        {next && (
          <a
            href={`/experiments/${next.id}`}
            class="group border border-border bg-card rounded-2xl p-5 text-right shadow-2xs transition-all hover:border-primary/50 hover:shadow-sm hover:bg-primary/2 sm:col-start-2"
          >
            <span class="font-mono text-[0.62rem] text-muted-foreground block">
              NEXT LOG / EXP-{formatNumber(next.data.experimentNumber)} →
            </span>
            <span class="font-heading mt-1 text-sm font-bold text-foreground group-hover:text-primary block transition-colors">
              {next.data.title}
            </span>
          </a>
        )}
      </div>
    </div>
  </article>
</BaseLayout>

<script>
  const progress = document.getElementById("reading-progress");

  const track = document.createElement("div");
  track.className = "reading-progress-track";

  const fill = document.createElement("div");
  fill.className = "reading-progress-fill";
  fill.style.transform = "scaleX(0)";

  if (progress) {
    progress.appendChild(track);
    progress.appendChild(fill);
  }

  let ticking = false;
  const update = () => {
    const doc = document.documentElement;
    const max = doc.scrollHeight - window.innerHeight;
    const ratio = max > 0 ? Math.min(1, window.scrollY / max) : 0;
    if (fill) fill.style.transform = `scaleX(${ratio})`;
    ticking = false;
  };

  const onScroll = () => {
    if (!ticking) {
      requestAnimationFrame(update);
      ticking = true;
    }
  };
  document.addEventListener("scroll", onScroll, { passive: true });
  window.addEventListener("resize", onScroll, { passive: true });
  update();

  const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"));
  if (tocLinks.length > 0) {
    const headings = tocLinks
      .map((link) => document.getElementById(link.getAttribute("href")!.slice(1)))
      .filter(Boolean) as HTMLElement[];

    const onScrollSpy = () => {
      const offset = 140;
      let currentId = "";
      for (const heading of headings) {
        if (heading.getBoundingClientRect().top <= offset) {
          currentId = heading.id;
        } else {
          break;
        }
      }
      for (const link of tocLinks) {
        const isActive = link.getAttribute("href") === `#${currentId}`;
        link.classList.toggle("text-primary", isActive);
        link.classList.toggle("font-semibold", isActive);
        link.classList.toggle("text-muted-foreground", !isActive);
        if (isActive) link.setAttribute("aria-current", "true");
        else link.removeAttribute("aria-current");
      }
    };
    document.addEventListener("scroll", onScrollSpy, { passive: true });
    onScrollSpy();
  }
</script>
