---
const currentPath = Astro.url.pathname;
const isHome = currentPath === "/";

// Simple path parsing for breadcrumbs
const pathSegments = currentPath.split("/").filter(Boolean);
---

<header class="sticky top-0 z-50 border-b border-border bg-background/80 backdrop-blur-md transition-all duration-200">
  <nav class="mx-auto flex h-(--header-h) w-full max-w-5xl items-center justify-between px-4 sm:px-6">
    <div class="flex items-center gap-3">
      <a href="/" class="group flex items-center gap-2.5 transition-transform active:scale-95" aria-label="Deep Learning Lab home">
        <span class="flex size-7 items-center justify-center rounded-xl bg-primary font-mono text-[0.65rem] font-black text-primary-foreground shadow-sm group-hover:rotate-6 transition-transform duration-200">
          DL
        </span>
        <span class="flex flex-col leading-none">
          <span class="font-sans text-sm font-extrabold tracking-tight text-foreground">Deep Learning Lab</span>
          <span class="mt-0.5 hidden font-mono text-[0.55rem] text-muted-foreground uppercase tracking-widest sm:block">
            manual.log
          </span>
        </span>
      </a>
      
      {pathSegments.length > 0 && (
        <div class="hidden items-center gap-1.5 font-mono text-[0.7rem] text-muted-foreground md:flex">
          <span class="text-border">/</span>
          <span class="bg-muted px-2 py-0.5 rounded-lg border border-border/50 text-[0.65rem] uppercase">
            {pathSegments[0]}
          </span>
          {pathSegments[1] && (
            <>
              <span class="text-border">/</span>
              <span class="text-foreground font-semibold">{pathSegments[1].replace("exp-", "EXP-")}</span>
            </>
          )}
        </div>
      )}
    </div>

    <div class="flex items-center gap-3">
      <a
        href="/"
        class:list={[
          "rounded-xl border border-border px-3 py-1 font-mono text-xs text-muted-foreground transition-all hover:border-primary hover:text-primary hover:bg-primary/5 active:scale-95",
          isHome && "bg-primary/5 border-primary/50 text-primary font-medium",
        ]}
      >
        index.html
      </a>
      <button
        data-theme-toggle
        type="button"
        class="inline-flex size-8 items-center justify-center border border-border rounded-xl text-muted-foreground transition-all hover:border-primary hover:text-primary hover:bg-primary/5 active:scale-95 focus-visible:outline-none"
        aria-label="Toggle theme"
      >
        <svg
          class="dark:hidden transition-transform duration-300 hover:rotate-45"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2"></path>
          <path d="M12 20v2"></path>
          <path d="m4.93 4.93 1.41 1.41"></path>
          <path d="m17.66 17.66 1.41 1.41"></path>
          <path d="M2 12h2"></path>
          <path d="M20 12h2"></path>
          <path d="m6.34 17.66-1.41 1.41"></path>
          <path d="m19.07 4.93-1.41 1.41"></path>
        </svg>
        <svg
          class="hidden dark:block transition-transform duration-300 hover:-rotate-12"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
        </svg>
      </button>
    </div>
  </nav>
</header>
